{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  
  "width": 600,
  "height": 800,

  "projection": { "type": "mercator" },

  "params": [
    {
      "name": "metric",
      "value": "Disposable Income per Person (Euro)",
      "bind": {
        "input": "select",
        "options": [
          "Disposable Income per Person (Euro)",
          "Disposable Household Income (Million)",
          "Rent of dwellings (including imputed rent of owner-occupied dwellings) (Million)"
        ],
        "name": "Select Metric: "
      }
    }
  ],

  "layer": [
    {
      "data": {
        "url": "ireland_topo.json",
        "format": { "type": "topojson", "feature": "IRL_adm1" }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "lightgray",
        "strokeWidth": 1,
        "fill": "white"
      }
    },

    {
      "data": {
        "url": "ireland_nuts2.geojson",
        "format": { "type": "json" }
      },

      "transform": [
        {
          "lookup": "properties.NUTS2NAME",
          "from": {
            "data": {
              "url": "RAA04_final_2014_2023.csv",
              "format": { "type": "tsv" }
            },
            "key": "NUTS 2 Region",
            "fields": [
              "Year",
              "Disposable Income per Person (Euro)",
              "Disposable Household Income (Million)",
              "Rent of dwellings (including imputed rent of owner-occupied dwellings) (Million)"
            ]
          }
        },
        { "filter": "datum.Year == 2023" },
        {
          "fold": [
            "Disposable Income per Person (Euro)",
            "Disposable Household Income (Million)",
            "Rent of dwellings (including imputed rent of owner-occupied dwellings) (Million)"
          ],
          "as": ["MetricName", "MetricValue"]
        },
        { "filter": "datum.MetricName == metric" }
      ],

      "mark": {
        "type": "geoshape",
        "stroke": "black",
        "strokeWidth": 1,
        "opacity": 0.45
      },

      "encoding": {
        "color": {
          "field": "properties.NUTS2NAME",
          "type": "nominal",
          "scale": {
            "domain": [
              "Eastern and Midland",
              "Northern and Western",
              "Southern"
            ],
            "range": ["#e67e22", "#3498db", "#2ecc71"]
          },
          "legend": null
        },
        "tooltip": [
          { "field": "properties.NUTS2NAME", "title": "Region" },
          { "field": "MetricName", "title": "Metric" },
          { "field": "MetricValue", "title": "Value" }
        ]
      }
    }
  ]
}
