{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 800,
  "projection": {"type": "identity", "reflectY": true},
  "data": {
    "url": "https://raw.githubusercontent.com/YuWei610/COMP40610_IV_Visual_Exploration_and_Communication/main/charts/NUTS2_Boundaries_100m.geojson",
    "format": {"type": "json", "property": "features"}
  },
  "transform": [
    {"calculate": "datum.properties.NUTS2NAME", "as": "NUTS2NAME"},
    {"calculate": "datum.properties.NUTS2", "as": "NUTS2"}
  ],
  "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 1},
  "encoding": {
    "tooltip": [
      {"field": "NUTS2NAME", "title": "Region"},
      {"field": "NUTS2", "title": "Code"}
    ]
  },
  "config": {}
}