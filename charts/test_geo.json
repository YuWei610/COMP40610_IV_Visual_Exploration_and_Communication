{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 800,

  "layer": [
    {
      "data": {
        "url": "ireland_topo.json",
        "format": {
          "type": "topojson",
          "feature": "IRL_adm1"
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "lightgray",
        "strokeWidth": 1,
        "fill": "white"
      },
      "projection": { "type": "mercator" }
    },

    {
      "data": {
        "url": "ireland_nuts2.geojson",
        "format": { "type": "json" }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "black",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "properties.NUTS_NAME",
          "type": "nominal",
          "legend": { "title": "NUTS2 Region" }
        },
        "opacity": { "value": 0.45 },  
        "tooltip": [
          { "field": "properties.NUTS_NAME", "title": "Region" }
        ]
      },
      "projection": { "type": "mercator" }
    }
  ]
}
