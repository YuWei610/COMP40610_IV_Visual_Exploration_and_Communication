    "\n",
    "df_2014 = df[df[\"Year\"] == 2014]\n",
    "df_2023 = df[df[\"Year\"] == 2023]\n",
    "\n",
    "df_2014.to_csv(\"../charts/2014_only.csv\", index=False)\n",
    "df_2023.to_csv(\"../charts/2023_only.csv\", index=False)\n"
   ]
  }
